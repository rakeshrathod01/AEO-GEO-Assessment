# ---------------------------------------------------------------------------
# eClerx SEO/AEO/GEO Assessment Platform — environment template
# Copy to .env and fill in. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# --- App ---
APP_ENV=local
DEBUG=true

# --- Database (local-first SQLite; swap to Postgres by changing this URL) ---
DATABASE_URL=sqlite:///./eclerx_assessment.db
# DATABASE_URL=postgresql+psycopg://eclerx:eclerx@localhost:5432/eclerx

# --- Celery / Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Secrets ---
# Master key used to derive the Fernet key that encrypts BYO credentials at rest.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-generate-a-strong-random-value

# --- Caching ---
CACHE_TTL_HOURS=24
AHREFS_WINDOW_MONTHS=6

# --- Auth / multi-tenancy ---
# Local-first default is False (requests resolve to a shared "default" tenant
# without logging in). Set True in production to require JWT auth per tenant.
AUTH_REQUIRED=false
JWT_EXPIRE_MINUTES=1440

# --- External-call rate limiting (per provider, per second; 0 disables) ---
EXTERNAL_RATE_LIMIT_PER_SEC=5

# ---------------------------------------------------------------------------
# BYO provider credentials
#
# These are managed in the in-app Settings page and stored ENCRYPTED AT REST
# (Fernet) — that is the canonical location. They are listed here only as a
# reference of every supported key. Values left here are NOT auto-loaded;
# enter them in Settings after the app starts.
# ---------------------------------------------------------------------------

# Core (required)
AHREFS_MCP_URL=            # e.g. https://your-ahrefs-mcp.example.com
FIRECRAWL_API_KEY=         # primary crawler
ANTHROPIC_API_KEY=         # Claude models (Haiku/Sonnet/Opus)

# Optional LLM providers (used by the GEO audit module)
OPENAI_API_KEY=            # ChatGPT
GEMINI_API_KEY=            # Google Gemini
PERPLEXITY_API_KEY=        # Perplexity
