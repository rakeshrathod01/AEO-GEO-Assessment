# ---------------------------------------------------------------------------
# eClerx SEO/AEO/GEO Assessment Platform — environment template
# Copy to .env and fill in. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# --- App ---
APP_ENV=local
DEBUG=true

# --- Database (local-first SQLite; swap to Postgres by changing this URL) ---
DATABASE_URL=sqlite:///./eclerx_assessment.db
# DATABASE_URL=postgresql+psycopg://eclerx:eclerx@localhost:5432/eclerx

# --- Celery / Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Secrets ---
# Master key used to derive the Fernet key that encrypts BYO API keys at rest.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-generate-a-strong-random-value

# --- Caching ---
CACHE_TTL_HOURS=24
AHREFS_WINDOW_MONTHS=6

# NOTE: Provider API keys (Anthropic, Firecrawl, Ahrefs) are NOT set here.
# They are entered in the app Settings page and stored encrypted at rest.
